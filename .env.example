# Notion
NOTION_TOKEN=your_notion_integration_token
NOTION_APPROVAL_QUEUE_DB=your_approval_queue_database_id
NOTION_CONTENT_PIPELINE_DB=your_content_pipeline_database_id

# Genius (for lyrics lookup in AI Insights / Song Detail)
GENIUS_ACCESS_TOKEN=your_genius_client_access_token

# YouTube Data API v3 (for video discovery in Song Detail)
YOUTUBE_API_KEY=your_youtube_api_key

# Google sign-in (Auth.js) — the whole app requires login
AUTH_SECRET=generate_with_npx_auth_secret
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
# Comma-separated Google accounts allowed in. Empty = nobody.
ALLOWED_EMAILS=you@example.com
